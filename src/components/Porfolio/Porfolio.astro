  NEXT: {
    name: "Nextjs",
    classColor: "bg-black text-white",
    icon: NextJs,
  },
  TAILWIND: {
    name: "Tailwindcss",
    classColor: "text-[#00bcff] bg-[#18242e]",
    icon: Tailwind,
  },
  SUPABASE: {
    name: "Supabase",
    classColor: "bg-[#1e1d23] text-[#45d092]",
    icon: Supabase,
  },
  POSTGRESQL: {
    name: "PostgreSQL",
    classColor: "bg-gray-200 text-[#30648a]",
    icon: PostgreSQL,
  },
  LARAVEL: {
    name: "Laravel",
    classColor: "bg-[#f8322d] text-white",
    icon: Laravel,
  },
  TYPSECRIPT: {
    name: "Typescript",
    classColor: "bg-[#3078c7] text-white",
