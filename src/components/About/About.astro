---
import Contact from "./Contact.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="about" class="container mx-auto md:max-w-2xl lg:max-w-4xl mb-20">
  <h2 class="font-bold text-center text-3xl mb-10">{t('about.title')}</h2>
  <div class="md:flex items-center gap-10">
    
    <div class="flex justify-center items-center mb-10 md:mb-0">
      <div class="inline-block p-2 border text-gray-400 dark:border-gray-800 rounded-md mx-auto">
        <img
          src="/daan_about.webp"
          class="w-64 rounded-md mx-auto"
          alt="Foto de Daan"
        />
      </div>
    </div>
    <div class="text-start md:max-w-sm lg:max-w-xl text-slate-800 dark:text-slate-300">
      <p>
        {t('about.p1.1')}<b class="text-mark-light dark:text-mark-dark">{t('about.p1.2')}</b>
        {t('about.p1.3')}<b class="text-mark-light dark:text-mark-dark">{t('about.p1.4')}</b>
        {t('about.p1.5')}<b class="text-mark-light dark:text-mark-dark">{t('about.p1.6')}</b>
        {t('about.p1.7')}<b class="text-mark-light dark:text-mark-dark">{t('about.p1.8')}</b>{t('about.p1.9')}
      </p>
      <p>
        {t('about.p2.1')}<b class="text-mark-light dark:text-mark-dark">{t('about.p2.2')}</b> 
        {t('about.p2.3')}
      </p>
      <p>
        {t('about.p3')}
      </p>
    </div>
  </div>
</section>
