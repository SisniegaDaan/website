---
import Footer from "../components/Footer/Footer.astro";
import DarkMode from "../components/icons/DarkMode.astro";
import LightMode from "../components/icons/LightMode.astro";
import UkFlag from "../components/icons/UkFlag.astro";
import SpainFlag from "../components/icons/SpainFlag.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { ViewTransitions } from "astro:transitions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} class="transition duration-300 ease-in-out">
  <head>
    <ViewTransitions />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/tw-elements/dist/css/index.min.css"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Desarrollador fullstack ubicado en Monterrey. Especializado en Nextjs, React, Node, Laravel y Odoo."
    />
    <title>Daan Solís - Desarrollador & Programador web</title>
  </head>

  <body class="relative dark:text-gray-100">
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full transition
      bg-white bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]
      dark:bg-neutral-950 dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>

    <header class="w-full py-4 fixed top-0 z-10">
      <nav class="flex justify-center md:justify-end mx-4">
        <ul
          class="flex items-center gap-1 md:gap-3 text-sm font-semibold bg-white dark:bg-slate-800 dark:bg-opacity-50 shadow-lg bg-opacity-50 backdrop-blur-lg rounded-md px-4 py-2"
        >
          <li>
            <a
              class="p-1 rounded-md hover:text-mark-light dark:hover:text-mark-dark transition"
              href="#top">{t('nav.home')}</a
            >
          </li>
          <li>
            <a
              class="p-1 rounded-md hover:text-mark-light dark:hover:text-mark-dark transition"
              href="#experience">{t('nav.experience')}</a
            >
          </li>
          <li>
            <a
              class="p-1 rounded-md hover:text-mark-light dark:hover:text-mark-dark transition"
              href="#porfolio">{t('nav.porfolio')}</a
            >
          </li>
          <li>
            <a
              class="p-1 rounded-md hover:text-mark-light dark:hover:text-mark-dark transition"
              href="#footer">{t('nav.contact')}</a
            >
          </li>
          <!-- Desktop Language & Theme -->
          <li class="hidden sm:block">
            <a
              class="p-1 rounded-md transition flex items-center justify-center hover:scale-110 hover:opacity-80"
              href={lang === 'es' ? '/en/' : '/'}
              title={lang === 'es' ? 'Switch to English' : 'Cambiar a Español'}
            >
              {lang === 'es' ? <UkFlag class="w-6 h-auto rounded-sm shadow-sm" /> : <SpainFlag class="w-6 h-auto rounded-sm shadow-sm" />}
            </a>
          </li>
          <li class="hidden sm:block">
            <button
              class="my-toggle-button p-1 rounded-md hover:text-mark-light dark:hover:text-mark-dark transition m-0"
            >
              <LightMode
                class="size-4 fill-white hidden dark:block dark:hover:fill-mark-dark transition"
              />
              <DarkMode
                class="size-4 fill-black block dark:hidden hover:fill-mark-light transition"
              />
            </button>
          </li>

          <!-- Mobile 3-dots menu -->
          <li class="sm:hidden relative">
            <button
              id="mobileMenuButton"
              class="p-1 rounded-md hover:text-mark-light dark:hover:text-mark-dark transition m-0 flex items-center justify-center"
            >
              <svg class="w-5 h-5 fill-current" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4 15">
                <path d="M3.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 6.041a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 5.959a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/>
              </svg>
            </button>
            <div id="mobileDropdown" class="absolute right-0 top-full mt-2 hidden bg-white rounded-lg shadow-xl w-36 dark:bg-slate-800 border border-gray-100 dark:border-slate-700">
                <ul class="py-2 text-sm text-gray-700 dark:text-gray-200">
                  <li>
                    <a href={lang === 'es' ? '/en/' : '/'} class="flex items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-slate-700 transition">
                      {lang === 'es' ? <UkFlag class="w-5 h-auto rounded-sm shadow-sm mr-2" /> : <SpainFlag class="w-5 h-auto rounded-sm shadow-sm mr-2" />}
                      {lang === 'es' ? 'English' : 'Español'}
                    </a>
                  </li>
                  <li>
                    <button class="my-toggle-button flex w-full items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-slate-700 transition">
                      <LightMode class="size-4 fill-white hidden dark:block mr-2" />
                      <DarkMode class="size-4 fill-black block dark:hidden mr-2" />
                      <span class="dark:hidden">{lang === 'es' ? 'Tema Oscuro' : 'Dark Mode'}</span>
                      <span class="hidden dark:block">{lang === 'es' ? 'Tema Claro' : 'Light Mode'}</span>
                    </button>
                  </li>
                </ul>
            </div>
          </li>
        </ul>
      </nav>
    </header>

    <main class="w-full px-4">
      <slot />
    </main>

    <Footer />

    <script src="/src/scripts/themeToggle.js"></script>
    <script src="/src/scripts/downAnimation.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flowbite@3.1.1/dist/flowbite.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tw-elements/dist/js/index.min.js"></script>
    <script src="/src/scripts/initSwipers.js"></script>
    <script src="/src/scripts/modalTransitions.js"></script>

    <!-- <script src="/src/scripts/showPorfolioGallery.js"></script>  -->
  </body>
</html>

<style>
  /* Variante Regular */
  @font-face {
    font-family: "Garet";
    src: url("../fonts/Garet-Regular.ttf") format("truetype");
    font-weight: 400; /* Normal */
    font-style: normal;
  }

  /* Variante Bold */
  @font-face {
    font-family: "Garet";
    src: url("../fonts/Garet-Bold.ttf") format("truetype");
    font-weight: 700; /* Bold */
    font-style: normal;
  }

  /* Variante Bold */
  @font-face {
    font-family: "Garet";
    src: url("../fonts/Garet-Regular-Italic.ttf") format("truetype");
    font-weight: 400; /* Bold */
    font-style: italic;
  }

  :root {
  }
  html,
  body {
    font-family: "Garet", sans-serif;
    color: #050505;
    display: flex;
    flex-direction: column;
    justify-content: center;
    scroll-behavior: smooth;
  }

  p > strong {
    color: blue
  }

</style>
